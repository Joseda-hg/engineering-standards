# Engineering Standards - C# formatting and style options.
# Copy to the consumer repository root (merge with existing entries). Diagnostic severities live in
# EngineeringStandards.globalconfig, not here.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{csproj,props,targets,slnx,xml,json}]
indent_style = space
indent_size = 2

[*.cs]
indent_style = space
indent_size = 4
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false
csharp_style_namespace_declarations = file_scoped
csharp_new_line_before_open_brace = all
csharp_indent_case_contents = true
csharp_indent_switch_labels = true

[**/obj/**/*.cs]
generated_code = true
# ASY-001: tool-generated files (e.g. xunit.v3 XunitAutoGeneratedEntryPoint.cs, which blocks in Main)
# are not authored code; BannedApiAnalyzers reports in generated code regardless of generated_code.
dotnet_diagnostic.RS0030.severity = none

[*.g.cs]
generated_code = true

[*.Designer.cs]
generated_code = true
