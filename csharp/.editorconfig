root = true

[*.cs]
indent_style = space
indent_size = 4
end_of_line = lf
insert_final_newline = true
dotnet_sort_system_directives_first = true
dotnet_diagnostic.CS8509.severity = warning

[**/obj/**/*.cs]
generated_code = true

[*.g.cs]
generated_code = true

[*.Designer.cs]
generated_code = true
